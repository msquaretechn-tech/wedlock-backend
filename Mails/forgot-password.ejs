<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wedlock Admin Password Reset</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @font-face {
            font-family: "Proxima Nova regular";
            src: url('../public/font/Proxima-Nova-Regular.otf') format("opentype");
            font-family: "Proxima Nova thin";
            src: url('../public/font/Proxima-Nova-Thin.otf') format("opentype");
        }

        body {
            font-family: "Proxima Nova regular", sans-serif;
            background-color: #F0FAFF;
            background-image: radial-gradient(#B8E4F2 1px, transparent 1px);
            background-size: 20px 20px;
        }

        p {
            font-family: "Proxima Nova thin", sans-serif;
            color: #5E5E5E;
        }

        .container {
            width: 100%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
            animation: fadeIn 0.8s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .main {
            width: 100%;
            max-width: 800px;
            background-color: #FFFFFF;
            padding: 2.5rem;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 126, 175, 0.15);
            border: 1px solid #D3F1FB;
            position: relative;
            overflow: hidden;
        }

        .main::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 8px;
            background: linear-gradient(90deg, #007EAF, #3CB8DA);
        }

        #title {
            margin-top: 1rem;
            margin-bottom: 10px;
            font-size: 18px;
            line-height: 21.92px;
            font-weight: 400;
            color: #5E5E5E;
        }

        #name {
            color: #007EAF;
            font-weight: 700;
        }

        .content h3 {
            margin: 1rem 0 2rem;
            color: #007EAF;
            font-size: 40px;
            font-weight: 700;
            line-height: 48.72px;
            position: relative;
            display: inline-block;
        }

        .content h3::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 60px;
            height: 4px;
            background: linear-gradient(90deg, #007EAF, #3CB8DA);
            border-radius: 2px;
        }

        .content p {
            margin: 2rem 0;
            font-size: 16px;
            line-height: 24px;
        }

        .otp {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin: 30px 0;
            flex-wrap: wrap;
        }

        .otp div {
            font-size: 42px;
            font-weight: 800;
            color: #FFFFFF;
            padding: 15px 25px;
            background: linear-gradient(135deg, #007EAF, #3CB8DA);
            border-radius: 12px;
            min-width: 70px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0, 126, 175, 0.25);
            animation: pulse 2s infinite;
            position: relative;
            overflow: hidden;
        }

        .otp div::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: rgba(255, 255, 255, 0.1);
            transform: rotate(45deg);
            animation: shine 3s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        @keyframes shine {
            0% { left: -100%; }
            20% { left: 100%; }
            100% { left: 100%; }
        }

        #char {
            margin-right: 20px;
        }

        #thakyou {
            margin-top: 10px;
            font-weight: 600;
            color: #007EAF;
        }

        .footer {
            font-size: 14px;
            color: #888;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #D3F1FB;
        }

        a {
            color: #007EAF;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        a:hover {
            color: #005F88;
            text-decoration: underline;
        }

        img {
            max-width: 100%;
            height: auto;
            transition: transform 0.3s ease;
        }

        img:hover {
            transform: scale(1.02);
        }

        .heart {
            color: #007EAF;
            animation: heartbeat 1.5s infinite;
            display: inline-block;
        }

        @keyframes heartbeat {
            0% { transform: scale(1); }
            25% { transform: scale(1.1); }
            50% { transform: scale(1); }
            75% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        .floating {
            animation: floating 6s ease-in-out infinite;
        }

        @keyframes floating {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-15px); }
            100% { transform: translateY(0px); }
        }

        .btn {
            display: inline-block;
            padding: 12px 30px;
            background: linear-gradient(135deg, #007EAF, #3CB8DA);
            color: white;
            text-decoration: none;
            border-radius: 30px;
            font-weight: 600;
            margin: 20px 0;
            box-shadow: 0 5px 15px rgba(0, 126, 175, 0.25);
            transition: all 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 126, 175, 0.35);
        }

        @media screen and (max-width: 600px) {
            .container {
                padding: 10px;
            }

            .main {
                padding: 1.8rem;
            }

            .content h3 {
                font-size: 32px;
                line-height: 38px;
            }

            .otp div {
                font-size: 32px;
                padding: 12px 20px;
                min-width: 60px;
            }

            .content p {
                font-size: 14px;
                line-height: 22px;
            }

            #title {
                font-size: 16px;
            }
        }

        @media screen and (max-width: 400px) {
            .otp div {
                font-size: 28px;
                padding: 10px 16px;
                min-width: 50px;
            }

            #char {
                margin-right: 10px;
            }

            .content h3 {
                font-size: 28px;
                line-height: 34px;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="main">
            <a href="https://wedlock.com.au" class="floating">
                <img src="https://wedlock.com.au/wedlock-img.jpg" alt="Wedlock Logo" style="max-width: 300px;">
            </a>
            <div class="content">
                <h2 id="title">Hello <span id="name"><%= name %></span>,</h2>
                <h3>Reset Your Password</h3>
                <p>We received a request to reset your Wedlock Admin password. To complete the process, please use the following verification code:</p>
                
                <div class="otp">
                    <% activationCode.split('').forEach((char) => { %>
                        <div id="char"><%= char %></div>
                    <% }) %>
                </div>
                
                <p>This code will expire in 15 minutes. If you didn't request a password reset, please ignore this email or contact our support team immediately.</p>
                
                <p>For security reasons, we recommend that you:</p>
                <ul style="margin-left: 20px; color: #5E5E5E;">
                    <li>Never share your password or verification codes</li>
                    <li>Use a strong, unique password</li>
                    <li>Update your password regularly</li>
                </ul>
                
                <p id="thakyou">With <span class="heart">♥</span>, The Wedlock Admin Team</p>
            </div>
            <div class="footer">
                <p>© 2025 Wedlock Admin Portal. All rights reserved.</p>
                <p><a href="https://admin.wedlock.com.au">https://admin.wedlock.com.au</a></p>
                <p>Need help? <a href="mailto:IT-support@wedlock.com.au">Contact our support team</a></p>
            </div>
        </div>
    </div>
</body>

</html>